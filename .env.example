NODE_ENV=development
APP_NAME=nestjs-production-scaffold
APP_PORT=3000
HTTP_ADAPTER=express
GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app
DB_PASSWORD=app
DB_DATABASE=app
DB_SYNCHRONIZE=true
DB_LOGGING=false

JWT_SECRET=change-me-at-least-32-characters-long
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
BCRYPT_ROUNDS=12

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_URL=amqp://app:app@localhost:5672
RABBITMQ_QUEUE=app.events
RABBITMQ_CONSUMER_ENABLED=true
RABBITMQ_PREFETCH=10

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=120
TENANT_HEADER=x-tenant-id

SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-123
