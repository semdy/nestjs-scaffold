NODE_ENV=development
APP_NAME=nestjs-production-scaffold
APP_PORT=3000
HTTP_ADAPTER=express
GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app
DB_PASSWORD=app
DB_DATABASE=app
DB_SYNCHRONIZE=true
DB_LOGGING=false

JWT_SECRET=change-me-at-least-32-characters-long
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
BCRYPT_ROUNDS=12

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_URL=amqp://app:app@localhost:5672
RABBITMQ_EXCHANGE=app.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_BINDING_KEY=#
RABBITMQ_MAX_RETRIES=2
RABBITMQ_QUEUE=app.events
RABBITMQ_CONSUMER_ENABLED=true
RABBITMQ_PREFETCH=10

DOCKER_DB_HOST=postgres
DEBEZIUM_ENABLED=false
DEBEZIUM_SOURCE_CONNECTOR_CLASS=io.debezium.connector.postgresql.PostgresConnector
DEBEZIUM_SOURCE_DATABASE_HOST=postgres
DEBEZIUM_SOURCE_DATABASE_PORT=5432
DEBEZIUM_SOURCE_DATABASE_USER=app
DEBEZIUM_SOURCE_DATABASE_PASSWORD=app
DEBEZIUM_SOURCE_DATABASE_DBNAME=app
DEBEZIUM_SOURCE_DATABASE_SERVER_ID=5401
DEBEZIUM_SOURCE_SCHEMA_INCLUDE_LIST=public
DEBEZIUM_SOURCE_TABLE_INCLUDE_LIST=public.outbox_events
DEBEZIUM_SOURCE_PLUGIN_NAME=pgoutput
DEBEZIUM_SOURCE_SLOT_NAME=nestjs_outbox
DEBEZIUM_SOURCE_PUBLICATION_NAME=nestjs_outbox_pub
DEBEZIUM_SOURCE_SNAPSHOT_MODE=initial
DEBEZIUM_SOURCE_OFFSET_STORAGE_FILE=data/offsets.dat
DEBEZIUM_SOURCE_SCHEMA_HISTORY_FILE=data/schema-history.dat
DEBEZIUM_RABBITMQ_EXCHANGE=app.events

OUTBOX_RETENTION_HOURS=72
OUTBOX_CLEANUP_BATCH_SIZE=1000

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=120
TENANT_HEADER=x-tenant-id

SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-123
