    "/api/v1/tenants": {
      "get": {
        "description": "Returns active tenants. Pass ?includeInactive=true to list all.",
        "operationId": "TenancyController_findAll_v1",
        "parameters": [
          {
            "name": "includeInactive",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TenantResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "List tenants",
        "tags": [
          "tenants"
        ]
      },
      "post": {
        "operationId": "TenancyController_create_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tenant created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Slug already exists"
          }
        },
        "summary": "Create tenant",
        "tags": [
          "tenants"
        ]
      }
    },
    "/api/v1/tenants/{id}": {
      "get": {
        "operationId": "TenancyController_findOne_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Tenant ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Tenant not found"
          }
        },
        "summary": "Get tenant by ID",
        "tags": [
          "tenants"
        ]
      },
      "patch": {
        "operationId": "TenancyController_update_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Tenant ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTenantDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tenant updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Tenant not found"
          }
        },
        "summary": "Update tenant",
        "tags": [
          "tenants"
        ]
      },
      "delete": {
        "description": "Soft delete (set inactive + Redis blacklist) by default. Pass ?hard=true for physical deletion.",
        "operationId": "TenancyController_remove_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Tenant ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hard",
            "required": false,
            "in": "query",
            "description": "Permanently delete the record",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant deleted"
          },
          "404": {
            "description": "Tenant not found"
          }
        },
        "summary": "Delete tenant",
        "tags": [
          "tenants"
        ]
      }
    },
