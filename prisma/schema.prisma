generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid(7)) @db.VarChar(36)
  slug      String   @unique(map: "IDX_tenants_slug") @db.VarChar(120)
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp()
  updatedAt DateTime @updatedAt @db.Timestamp()

  memberships     TenantMembership[]
  roles           Role[]
  roleAssignments UserRoleAssignment[]
  refreshTokens   RefreshToken[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid(7)) @db.VarChar(36)
  email        String?  @unique(map: "UQ_users_email") @db.VarChar(180)
  phone        String?  @db.VarChar(32)
  countryCode  String?  @db.VarChar(8)
  name         String   @db.VarChar(120)
  passwordHash String?  @db.VarChar(255)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamp()
  updatedAt    DateTime @updatedAt @db.Timestamp()

  memberships     TenantMembership[]
  roleAssignments UserRoleAssignment[]
  refreshTokens   RefreshToken[]

  @@unique([countryCode, phone], map: "UQ_users_country_phone")
  @@index([active, createdAt], map: "IDX_users_active_created_at")
  @@map("users")
}

model TenantMembership {
  userId    String   @db.VarChar(36)
  tenantId  String   @db.VarChar(36)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp()
  updatedAt DateTime @updatedAt @db.Timestamp()

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId, active, createdAt], map: "IDX_memberships_tenant_active_created_at")
  @@map("tenant_memberships")
}

model Role {
  id          String   @id @default(uuid(7)) @db.VarChar(36)
  tenantId    String?  @db.VarChar(36)
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String   @default("") @db.VarChar(255)
  builtIn     Boolean  @default(false)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamp()
  updatedAt   DateTime @updatedAt @db.Timestamp()

  tenant      Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments UserRoleAssignment[]
  permissions RolePermission[]

  @@unique([tenantId, code], map: "UQ_roles_tenant_code")
  @@index([tenantId, enabled, code], map: "IDX_roles_tenant_enabled_code")
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.VarChar(36)
  code        String   @unique(map: "UQ_permissions_code") @db.VarChar(100)
  name        String   @db.VarChar(100)
  description String   @default("") @db.VarChar(255)
  builtIn     Boolean  @default(false)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamp()
  updatedAt   DateTime @updatedAt @db.Timestamp()

  roles RolePermission[]

  @@index([enabled, code], map: "IDX_permissions_enabled_code")
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.VarChar(36)
  permissionId String @db.VarChar(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "IDX_role_permissions_permission_id")
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId    String   @db.VarChar(36)
  tenantId  String   @db.VarChar(36)
  roleId    String   @db.VarChar(36)
  createdAt DateTime @default(now()) @db.Timestamp()

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId, roleId])
  @@index([tenantId, roleId], map: "IDX_user_roles_tenant_role")
  @@index([roleId], map: "IDX_user_roles_role_id")
  @@map("user_role_assignments")
}

model RefreshToken {
  id                String    @id @default(uuid(7)) @db.VarChar(36)
  tenantId          String    @db.VarChar(36)
  userId            String    @db.VarChar(36)
  tokenHash         String    @unique(map: "IDX_refresh_tokens_token_hash") @db.VarChar(64)
  expiresAt         DateTime  @db.Timestamp()
  revokedAt         DateTime? @db.Timestamp()
  replacedByTokenId String?   @db.VarChar(36)
  userAgent         String?   @db.VarChar(512)
  ipAddress         String?   @db.VarChar(64)
  createdAt         DateTime  @default(now()) @db.Timestamp()
  updatedAt         DateTime  @updatedAt @db.Timestamp()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "IDX_refresh_tokens_tenant_id")
  @@index([userId], map: "IDX_refresh_tokens_user_id")
  @@index([userId, revokedAt, expiresAt], map: "IDX_refresh_tokens_user_revoked_expires")
  @@map("refresh_tokens")
}

model OutboxEvent {
  id            String   @id @default(uuid(7)) @db.VarChar(36)
  tenantId      String   @db.VarChar(36)
  aggregateType String   @db.VarChar(80)
  aggregateId   String   @db.VarChar(36)
  routingKey    String   @db.VarChar(120)
  payload       Json     @db.Json
  createdAt     DateTime @default(now()) @db.Timestamp()

  @@index([tenantId, createdAt], map: "IDX_outbox_events_tenant_created_at")
  @@index([aggregateType, aggregateId], map: "IDX_outbox_events_aggregate")
  @@index([routingKey, createdAt], map: "IDX_outbox_events_routing_key_created_at")
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String   @id @db.VarChar(36)
  routingKey  String   @db.VarChar(120)
  processedAt DateTime @db.Timestamp()
  expiresAt   DateTime @db.Timestamp()

  @@index([expiresAt], map: "IDX_processed_events_expires")
  @@map("processed_events")
}
