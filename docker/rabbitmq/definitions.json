{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "users": [
    {
      "name": "app",
      "password": "app",
      "tags": ""
    }
  ],
  "permissions": [
    {
      "user": "app",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "queues": [
    {
      "name": "app.events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "",
        "x-dead-letter-routing-key": "app.events.dlq"
      }
    },
    {
      "name": "app.events.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "exchanges": [
    {
      "name": "app.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "app.events",
      "vhost": "/",
      "destination": "app.events",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    }
  ]
}
